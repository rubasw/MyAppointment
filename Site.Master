<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="ruba10828tl.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <title>King Fahad Medical City</title>

   
    <style>
        .menu ul.static {
            display: flex;
            gap: 25px;  
            list-style-type: none;
            margin: 0;
            padding: 0;
        }

        .menu ul.static li a {
            color: white !important;   
            text-decoration: none;
            font-size: 16px;
            padding: 5px 10px;
        }

        .menu ul.static li a:hover {
            background-color: #444;
            border-radius: 4px;
        }
    </style>
</head>
<body>
    <form runat="server">

        
        <div style="background-color: green; color: white; padding: 15px; text-align: center; font-size: 26px; font-weight: bold;">
            King Fahad Medical City
        </div>

        <div style="background-color: #666; padding: 10px;">
            <asp:Menu ID="NavigationMenu" runat="server" Orientation="Horizontal" 
                      StaticDisplayLevels="1" CssClass="menu">
                <Items>
                    <asp:MenuItem Text="About Us" NavigateUrl="~/AboutUs/AboutUs.aspx" />
                    <asp:MenuItem Text="Register / Login" NavigateUrl="~/Auth/Login.aspx" />
                    <asp:MenuItem Text="Book & View Appointment" NavigateUrl="~/Appointment/BookAndview.aspx" />
                    <asp:MenuItem Text="Rating" NavigateUrl="~/Rating/Rating.aspx" />
                    <asp:MenuItem Text="Contact" NavigateUrl="~/Contact/Contact.aspx" />
                </Items>
            </asp:Menu>
        </div>

       
        <div style="padding: 20px;">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </div>

    </form>
</body>
</html>